{
  "name": "gold-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:engine": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:cloud": "vitest run --config vitest.cloud.config.ts",
    "test:e2e": "playwright test",
    "test": "vitest run && vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "bcryptjs": "3.0.2",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
